# ============================================
# PUBLIC ENVIRONMENT VARIABLES
# These are exposed to the browser (safe non-secret data only)
# ============================================

# Supabase project URL (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (public, limited permissions)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Application URL (used in emails and redirects)
NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# ============================================
# SERVER-ONLY ENVIRONMENT VARIABLES
# These are never sent to the browser
# ============================================

# Database connection string (PostgreSQL)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/votehub

# Supabase project URL (server-side)
SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (server-side)
SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (NEVER expose in client code)
# This key has full permissions - keep it secure!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NextAuth configuration
NEXTAUTH_URL=https://your-production-domain.com
NEXTAUTH_SECRET=your-long-secure-random-string-at-least-32-characters

# ============================================
# EMAIL CONFIGURATION (Optional)
# Choose one provider or leave empty for console logging only
# ============================================

# Email provider: sendgrid, resend, smtp, or leave empty
EMAIL_PROVIDER=sendgrid

# API key for email provider (SendGrid or Resend)
EMAIL_API_KEY=your-email-provider-api-key

# Sender email address for notifications
EMAIL_FROM=noreply@your-production-domain.com

# For SMTP provider only
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Application version (optional)
APP_VERSION=1.0.0

# Rate limiting: use memory only for local development.
# Production requires a shared Upstash Redis backend.
RATE_LIMIT_BACKEND=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Node environment
NODE_ENV=production

